<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/appBackground"
    tools:context=".ProgrammeSetupWizardActivity">

    <!-- Top Wave Graphic (Aligned with Dashboard style) -->
    <ImageView
        android:id="@+id/topWave"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_top_wave"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Back Button -->
    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:padding="6dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvWizardTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Programme Wizard"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/ivBack"
        app:layout_constraintStart_toEndOf="@id/ivBack"
        app:layout_constraintTop_toTopOf="@id/ivBack" />

    <!-- Stepper Container Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardStepper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/inputBackground"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:layout_constraintTop_toBottomOf="@id/ivBack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Circular Step Stepper -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Step 1 Indicator -->
                <TextView
                    android:id="@+id/tvStep1"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circle_blue"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/lineStep1to2"
                    android:layout_width="32dp"
                    android:layout_height="2dp"
                    android:background="@color/dividerColor" />

                <!-- Step 2 Indicator -->
                <TextView
                    android:id="@+id/tvStep2"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circle_gray"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/lineStep2to3"
                    android:layout_width="32dp"
                    android:layout_height="2dp"
                    android:background="@color/dividerColor" />

                <!-- Step 3 Indicator -->
                <TextView
                    android:id="@+id/tvStep3"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circle_gray"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/lineStep3to4"
                    android:layout_width="32dp"
                    android:layout_height="2dp"
                    android:background="@color/dividerColor" />

                <!-- Step 4 Indicator -->
                <TextView
                    android:id="@+id/tvStep4"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circle_gray"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/lineStep4to5"
                    android:layout_width="32dp"
                    android:layout_height="2dp"
                    android:background="@color/dividerColor" />

                <!-- Step 5 Indicator -->
                <TextView
                    android:id="@+id/tvStep5"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_circle_gray"
                    android:gravity="center"
                    android:text="5"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Step Label -->
            <TextView
                android:id="@+id/tvStepTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Step 1: Programme Details"
                android:textColor="@color/textColorPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Main Content Panels Container -->
    <ScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/llFooterActions"
        app:layout_constraintTop_toBottomOf="@id/cardStepper">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- STEP 1 PANEL -->
            <LinearLayout
                android:id="@+id/panelStep1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Core Programme Details"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <!-- Programme ID -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Programme ID *"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etProgId"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_rounded_input"
                    android:hint="e.g. BSc-IT"
                    android:inputType="textCapCharacters"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="14sp" />

                <!-- Programme Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Programme Name *"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etProgName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_rounded_input"
                    android:hint="e.g. Bachelor of Science in IT"
                    android:inputType="textCapWords"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="14sp" />

                <!-- Duration -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Duration (Years) *"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinnerProgDuration"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_rounded_input"
                    android:paddingHorizontal="12dp" />

            </LinearLayout>

            <!-- STEP 2 PANEL -->
            <LinearLayout
                android:id="@+id/panelStep2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Initial Batch Setup"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add the first academic batch for this programme. More batches can be configured later from Batch Management."
                    android:textColor="@color/textColorSecondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp"/>

                <!-- Batch Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Batch Name *"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etBatchName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_rounded_input"
                    android:hint="e.g. 2026 Intake"
                    android:inputType="textCapWords"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="14sp" />

                <!-- Batch ID -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Batch ID *"
                    android:textColor="@color/textColorSecondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etBatchId"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_rounded_input"
                    android:hint="e.g. BATCH-26"
                    android:inputType="textCapCharacters"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- STEP 3 PANEL -->
            <LinearLayout
                android:id="@+id/panelStep3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Semester Preview"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvSemesterExplanation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Based on your selected duration of 3 Years, 6 semesters will be automatically generated and mapped to this batch."
                    android:textColor="@color/textColorSecondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp"/>

                <!-- Semester list wrapper -->
                <LinearLayout
                    android:id="@+id/llSemesterPreviewList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:divider="@color/dividerColor"
                    android:showDividers="middle"
                    android:background="@drawable/bg_rounded_input"
                    android:padding="8dp" />

            </LinearLayout>

            <!-- STEP 4 PANEL -->
            <LinearLayout
                android:id="@+id/panelStep4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enroll Students"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Onboard students directly into the newly created batch. You can add them one-by-one below."
                    android:textColor="@color/textColorSecondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp"/>

                <!-- Add Student Form -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/inputBackground"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <EditText
                            android:id="@+id/etStudentId"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:hint="Student ID (e.g. STU001) *"
                            android:background="@drawable/bg_rounded_input"
                            android:paddingHorizontal="12dp"
                            android:textSize="13sp"
                            android:layout_marginBottom="8dp"
                            android:inputType="textCapCharacters"/>

                        <EditText
                            android:id="@+id/etStudentName"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:hint="Full Name *"
                            android:background="@drawable/bg_rounded_input"
                            android:paddingHorizontal="12dp"
                            android:textSize="13sp"
                            android:layout_marginBottom="8dp"
                            android:inputType="textCapWords"/>

                        <EditText
                            android:id="@+id/etStudentEmail"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:hint="Email *"
                            android:background="@drawable/bg_rounded_input"
                            android:paddingHorizontal="12dp"
                            android:textSize="13sp"
                            android:layout_marginBottom="8dp"
                            android:inputType="textEmailAddress"/>

                        <EditText
                            android:id="@+id/etStudentPassword"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:hint="Password (Optional - default: 123456)"
                            android:background="@drawable/bg_rounded_input"
                            android:paddingHorizontal="12dp"
                            android:textSize="13sp"
                            android:layout_marginBottom="12dp"
                            android:inputType="textPassword"/>

                        <Button
                            android:id="@+id/btnAddStudentLocal"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:text="Add Student"
                            android:textColor="@android:color/white"
                            android:backgroundTint="@color/colorAccent"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnUploadCsvStudents"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="8dp"
                            android:text="Upload Students CSV"
                            android:textColor="@color/colorPrimary"
                            android:background="@drawable/bg_outline_button"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textAllCaps="false" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Students Added Section -->
                <TextView
                    android:id="@+id/tvEnrolledLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enrolled List (0)"
                    android:textColor="@color/textColorPrimary"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp"/>

                <!-- Student List Wrapper -->
                <LinearLayout
                    android:id="@+id/llStudentListWrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_rounded_input"
                    android:padding="8dp"/>

            </LinearLayout>

            <!-- STEP 5 PANEL -->
            <LinearLayout
                android:id="@+id/panelStep5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Module Configuration"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add modules (courses) and bind them to the automatically generated semesters for this batch."
                    android:textColor="@color/textColorSecondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp"/>

                <!-- Add Module Card Form -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/inputBackground"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <Spinner
                            android:id="@+id/spinnerModuleSemester"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_rounded_input"
                            android:paddingHorizontal="12dp"
                            android:layout_marginBottom="8dp"/>

                        <EditText
                            android:id="@+id/etModuleCode"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:hint="Module Code/ID (e.g. CO4501) *"
                            android:background="@drawable/bg_rounded_input"
                            android:paddingHorizontal="12dp"
                            android:textSize="13sp"
                            android:layout_marginBottom="8dp"
                            android:inputType="textCapCharacters"/>

                        <EditText
                            android:id="@+id/etModuleName"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:hint="Module Name *"
                            android:background="@drawable/bg_rounded_input"
                            android:paddingHorizontal="12dp"
                            android:textSize="13sp"
                            android:layout_marginBottom="8dp"
                            android:inputType="textCapWords"/>

                        <EditText
                            android:id="@+id/etModuleCredits"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:hint="Credits (e.g. 3) *"
                            android:background="@drawable/bg_rounded_input"
                            android:paddingHorizontal="12dp"
                            android:textSize="13sp"
                            android:layout_marginBottom="12dp"
                            android:inputType="number"/>

                        <Button
                            android:id="@+id/btnAddModuleLocal"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:text="Add Module"
                            android:textColor="@android:color/white"
                            android:backgroundTint="@color/colorAccent"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnUploadCsvModules"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="8dp"
                            android:text="Upload Modules CSV"
                            android:textColor="@color/colorPrimary"
                            android:background="@drawable/bg_outline_button"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textAllCaps="false" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Modules List Section -->
                <TextView
                    android:id="@+id/tvModulesLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Configured Modules (0)"
                    android:textColor="@color/textColorPrimary"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp"/>

                <!-- Module List Wrapper -->
                <LinearLayout
                    android:id="@+id/llModuleListWrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_rounded_input"
                    android:padding="8dp"/>

            </LinearLayout>

        </FrameLayout>
    </ScrollView>

    <!-- Footer Action Buttons -->
    <LinearLayout
        android:id="@+id/llFooterActions"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/inputBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPrevious"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Previous"
            android:textColor="@color/textColorSecondary"
            android:background="@drawable/bg_outline_button"
            android:paddingHorizontal="20dp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Next Step"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_gradient_button"
            android:paddingHorizontal="24dp"
            android:textAllCaps="false"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
