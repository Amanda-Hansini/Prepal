<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_rounded_input"
    android:padding="16dp">

    <!-- Module Name Automatically Displayed -->
    <TextView
        android:id="@+id/tvModuleNameCa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Module Name"
        android:textColor="@color/textColorPrimary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <!-- Midterm & Assignment Mark Input Fields Side-by-Side -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Midterm Mark (out of 20) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Midterm Mark (/20)"
                android:textColor="@color/textColorSecondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etMidMark"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_rounded_input"
                android:hint="0 - 20"
                android:inputType="numberDecimal"
                android:paddingHorizontal="12dp"
                android:textColor="@color/textColorPrimary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Assignment Mark (out of 20) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assignment Mark (/20)"
                android:textColor="@color/textColorSecondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etAssignmentMark"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_rounded_input"
                android:hint="0 - 20"
                android:inputType="numberDecimal"
                android:paddingHorizontal="12dp"
                android:textColor="@color/textColorPrimary"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
