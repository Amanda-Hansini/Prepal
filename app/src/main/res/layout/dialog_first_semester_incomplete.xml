<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    android:layout_margin="24dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="32dp"
        android:paddingBottom="24dp"
        android:paddingEnd="24dp"
        android:paddingStart="24dp"
        android:gravity="center">

        <!-- Warning Icon Circle -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_circle_light_red"
            android:layout_marginBottom="20dp">
            
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_warning"
                app:tint="@color/warningRed" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvIncompleteTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Incomplete First Semester"
            android:textAlignment="center"
            android:textColor="#1A202C"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvIncompleteMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prepal cannot calculate your GPA and AI prediction due to incomplete results (MC, AB, NE, WH, or INC) in your very first semester. You cannot continue using the application."
            android:textAlignment="center"
            android:lineSpacingExtra="4dp"
            android:textColor="#4A5568"
            android:textSize="15sp"
            android:layout_marginBottom="28dp" />

        <!-- Back to Login Button -->
        <!-- Update/Enter Results Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEnterResultsNow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_gradient_button"
            android:text="Update Grades"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Back to Login Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBackToLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_rounded_input"
            android:text="Back to Login"
            android:textAllCaps="false"
            android:textColor="#4A5568"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
